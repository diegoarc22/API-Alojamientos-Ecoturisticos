  "latitud": 38.95,
  "longitud": -2.85,
  "precioNoche": 120.0,
  "capacidad": 10,
  "fechaApertura": "2021-06-01",
  "certificadoEco": true,
  "actividades": ["kayak", "astroturismo"],
  "aceptaPoliticaSostenible": true
}

###  Crear glamping válido (se usa en los PATCH de abajo) -> 201
POST http://localhost:8080/api/alojamientos
Content-Type: application/json

{
  "codigoRegistro": "ECO-0101",
  "nombre": "Glamping Lagunas de Ruidera",
  "tipo": "GLAMPING",
  "provincia": "Ciudad Real",
  "latitud": 38.95,
  "longitud": -2.85,
  "precioNoche": 120.0,
  "capacidad": 2,
  "fechaApertura": "2021-06-01",
  "certificadoEco": true,
  "actividades": ["kayak", "astroturismo"],
  "aceptaPoliticaSostenible": true
}

> {% client.global.set("idGlamping", response.body.id); %}

###  PATCH que deja el glamping para 10 personas -> 422
PATCH http://localhost:8080/api/alojamientos/{{idGlamping}}
Content-Type: application/json

{
  "capacidad": 10
}

###  PATCH con un precio negativo -> 400
PATCH http://localhost:8080/api/alojamientos/{{idGlamping}}
Content-Type: application/json

{
  "precioNoche": -5
}

